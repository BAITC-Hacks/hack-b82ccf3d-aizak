# Copy to backend/.env and paste your OpenAI API key locally. Never commit .env.
# Environment variables override this file. NVIDIA keys are not supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AIZAK_AI_ENABLED=true
# Socket timeout, seconds (0.1 to 8); one request, no automatic retries.
AIZAK_AI_TIMEOUT_SECONDS=8
